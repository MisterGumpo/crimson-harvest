{
  "name": "crimson-harvest/pvp-dashboard",
  "description": "CRIMSON HARVEST EVE Online PvP competition dashboard",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "CrimsonHarvest\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CrimsonHarvest\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "seed-demo": "php bin/seed-demo.php",
    "migrate": "php bin/migrate.php",
    "import-kill": "php bin/import-kill.php"
  }
}
